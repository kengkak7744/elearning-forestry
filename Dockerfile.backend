FROM python:3.13-slim

# System deps for psycopg, WeasyPrint, bcrypt
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz0b \
    libcairo2 \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt gunicorn

COPY backend/ .

# Default Gunicorn settings — overridable via env
ENV PYTHONUNBUFFERED=1
ENV WORKERS=4
# Gunicorn's default --timeout is 30s: it kills any worker whose request runs
# longer than this. A large PDF upload (e.g. a 180 MB scanned manual for the
# auto-split) takes well over 30s just to transfer, so the worker is killed
# mid-upload and the request stalls/dies — while smaller files that finish
# inside 30s succeed. Raise it to 5 minutes so big uploads + the split have room.
ENV TIMEOUT=300

CMD gunicorn app.main:app \
    -w ${WORKERS} \
    -k uvicorn.workers.UvicornWorker \
    --bind 0.0.0.0:8000 \
    --timeout ${TIMEOUT} \
    --access-logfile - \
    --error-logfile -