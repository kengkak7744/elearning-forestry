# Copy to .env on the deployment host and replace every placeholder.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/elearning_forestry
SECRET_KEY=replace-with-a-long-random-secret

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=True
PUBLIC_BASE_URL=Webbase URL of the deployed application, e.g. https://elearning-forestry.example.com

# Optional: used by backend/seed_admin.py. If ADMIN_PASSWORD is omitted, the
# script generates and prints a one-time random password.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@forest.go.th
ADMIN_PASSWORD=
